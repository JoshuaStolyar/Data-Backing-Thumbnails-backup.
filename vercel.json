{
  "rewrites": [
    {
      "source": "/sw.js",
      "destination": "/sw.js"
    },
    {
      "source": "/tests",
      "destination": "/tests.html"
    },
    {
      "source": "/tests.html",
      "destination": "/tests.html"
    },
    {
      "source": "/(.*)",
      "destination": "/library.html"
    }
  ]
}
